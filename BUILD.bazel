# Gazelle manages the bzl_library graph for the private/... packages.
# gazelle:exclude private/tests

# Test-only Starlark (unittest suites) has no doc consumers.
# gazelle:exclude **/*_test.bzl

# gazelle:map_kind bzl_library bzl_library @aspect_bazel_lib//:bzl_library.bzl

load("@aspect_bazel_lib//:bzl_library.bzl", "bzl_library")

exports_files(["defs.bzl"])

alias(
    name = "buildifier",
    actual = "@buildifier_prebuilt//buildifier",
)

alias(
    name = "gazelle",
    actual = "//tools/gazelle",
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//private:build",
        "//private:cli",
        "//private:run",
        "//private:test",
    ],
)
