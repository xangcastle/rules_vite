load("@aspect_bazel_lib//:bzl_library.bzl", "bzl_library")

exports_files([
    "build.bzl",
    "cli.bzl",
    "run.bzl",
    "test.bzl",
])

bzl_library(
    name = "build",
    srcs = ["build.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//private/helpers:node"],
)

bzl_library(
    name = "cli",
    srcs = ["cli.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//private/helpers:js_stub_binary",
        "//private/helpers:node",
    ],
)

bzl_library(
    name = "run",
    srcs = ["run.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//private/helpers:js_stub_binary",
        "//private/helpers:node",
    ],
)

bzl_library(
    name = "test",
    srcs = ["test.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//private/helpers:js_stub_binary",
        "//private/helpers:node",
    ],
)
