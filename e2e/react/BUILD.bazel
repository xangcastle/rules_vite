load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_vite//:defs.bzl", "node_cli", "vite_build", "vite_run", "vitest_test")

npm_link_all_packages(name = "node_modules")

vite_build(
    name = "web",
    srcs = glob(["src/**"]) + [
        "index.html",
        "package.json",
        "vite.config.ts",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/@vitejs/plugin-react",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/vite",
    ],
)

vitest_test(
    name = "unit_tests",
    srcs = glob(["src/**"]) + [
        "index.html",
        "package.json",
        "vite.config.ts",
    ],
    config = "vite.config.ts",
    node_modules = "//:node_modules",
)

vite_run(
    name = "web.dev",
    args = [
        "--host",
        "--port",
        "5199",
        "--strictPort",
    ],
)

node_cli(
    name = "shadcn",
    package = "//:node_modules/shadcn",
)

vitest_test(
    name = "declared_config_test",
    srcs = glob(["src/**"]) + [
        "index.html",
        "package.json",
        "vite.config.ts",
        "vitest.config.ts",
    ],
    config = "vite.config.ts",
    node_modules = "//:node_modules",
)

vite_run(
    name = "web_deps.dev",
    deps = [
        "//:node_modules/@vitejs/plugin-react",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/vite",
    ],
)

vite_build(
    name = "web_sourcemap",
    srcs = glob(["src/**"]) + [
        "index.html",
        "package.json",
        "vite.config.ts",
    ],
    args = ["--sourcemap"],
    deps = [
        "//:node_modules/@vitejs/plugin-react",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/vite",
    ],
)

js_test(
    name = "web_sourcemap_sources_host_independent_test",
    args = ["$(rootpath :web_sourcemap)"],
    data = [":web_sourcemap"],
    entry_point = "sourcemap_sources_test.mjs",
)
